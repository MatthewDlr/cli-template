{
  "name": "template-cli",
  "version": "0.1.0",
  "private": true,
  "description": "A CLI tool to supercharge developer experience",
  "bin": {
    "cli": "./cli.ts"
  },
  "type": "module",
  "scripts": {
    "build": "bun build --compile --minify cli.ts --outfile template-cli",
    "check": "bun run fmt:check && bun run lint:ci && bun run test",
    "dev": "bun --watch cli.ts",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint",
    "lint:agent": "oxlint --deny-warnings --format=agent",
    "lint:ci": "oxlint --quiet",
    "lint:fix": "oxlint --fix --fix-suggestions",
    "test": "bun test",
    "test:coverage": "bun test --coverage",
    "test:watch": "bun test --watch",
    "typecheck": "tsrs --noEmit --fast"
  },
  "dependencies": {
    "@clack/prompts": "^1.9.0",
    "neverthrow": "^8.2.0",
    "picocolors": "^1.1.1",
    "terminal-link": "^5.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0",
    "oxlint-tsgolint": "^7.0.2005",
    "tsrs": "^0.24.0-ts7.1.0-beta"
  }
}
